# Prisma Postgres connection for application/runtime queries and Prisma CLI work.
#
# This project follows the Sauti setup: `DATABASE_URL` is the only required
# database environment variable.
DATABASE_URL=""

# Optional, and read by exactly one command: `npm run db:migrate`
# (`prisma migrate dev`).
#
# That command replays the migrations against a throwaway copy of the database
# to check they produce the schema the schema file describes. It normally
# creates and drops that copy itself, which requires CREATE DATABASE — hosted
# providers often withhold it, and the command then fails.
#
# If yours does, point this at a scratch database you are willing to see reset.
# Leave it unset in production: `npm run db:deploy` never reads it.
# SHADOW_DATABASE_URL=

# Public origin used for canonical URLs, Open Graph tags, sitemap and robots.
# Falls back to the placeholder below when unset, so the build never hard-fails.
NEXT_PUBLIC_SITE_URL=https://aurel-and-ash.vercel.app

# Caps connections per Prisma client (default 2).
#
# Raise it for a long-running server against a database with headroom; lower it
# on serverless, where the provider's own connection limit — not this number —
# is usually the constraint.
# DATABASE_POOL_SIZE=

# Caps parallel workers while prerendering (default: 2).
#
# Only worth setting against a database with a small connection limit, such as a
# free tier, where a build's burst of parallel page renders exceeds what it will
# hand out. Pair with a lower DATABASE_POOL_SIZE to shrink the burst from both
# ends. Leave both unset against a database sized for it.
# NEXT_BUILD_CPUS=
