# PostgreSQL connection string. Required.
#
# The app connects through the pg driver adapter, so this must be a direct
# `postgresql://` URL rather than a Prisma proxy URL. On Vercel use the
# *pooled* connection string your provider issues (typically port 5432 with
# `?pgbouncer=true&connection_limit=1`), which is what a serverless function
# needs so concurrent requests do not exhaust the database's connection limit.
#
# Migrations are applied with `npm run db:deploy`; run it once before the first
# production deploy.
DATABASE_URL=

# Public origin used for canonical URLs, Open Graph tags, sitemap and robots.
# Falls back to the placeholder below when unset, so the build never hard-fails.
NEXT_PUBLIC_SITE_URL=https://aurel-and-ash.vercel.app

# Escape hatches for constrained local databases. Neither is needed in
# production; leave both unset against a normal PostgreSQL.
#
# DATABASE_POOL_SIZE caps connections per Prisma client (default 5).
# NEXT_BUILD_CPUS caps parallel workers while prerendering (default: one per CPU).
# The embedded `prisma dev` server tolerates only ~10 concurrent connections and
# terminates the rest, so building against it wants both turned down, e.g.
#   NEXT_BUILD_CPUS=2 DATABASE_POOL_SIZE=2 npm run build
# DATABASE_POOL_SIZE=
# NEXT_BUILD_CPUS=
