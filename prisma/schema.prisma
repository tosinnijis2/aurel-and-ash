// AUREL & ASH storefront schema.
//
// Two rules shape everything here:
//
//  1. Money is Decimal(10,2). No float ever touches a price.
//  2. Availability is always derived from ProductVariant.quantity. There is
//     deliberately no product-level stock flag, because it would be a second
//     source of truth that could disagree with the variants it summarises.
//
// The connection string lives in prisma.config.ts, not in this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Controlled set so /shop filtering stays predictable and the UI can render
/// every category without a lookup table.
enum ProductCategory {
  CLOTHING
  ACCESSORIES
}

/// Chooses which generated flat ProductArt draws while photography is pending.
/// Stored per product so real imagery can displace it without a code change.
enum ProductSilhouette {
  HOODIE
  TEE
  CAP
  TOTE
  CREWNECK
}

/// Backdrop for the generated artwork. Every value stays in the neutral palette.
enum ProductTone {
  BONE
  CHALK
  SAND
  STONE
  ASH
}

model Product {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  /// One-line editorial summary shown under the name on cards.
  tagline     String
  description String
  /// Exact decimal currency. Converted to integer cents once, for display only.
  price       Decimal           @db.Decimal(10, 2)
  category    ProductCategory
  featured    Boolean           @default(false)
  silhouette  ProductSilhouette
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  variants ProductVariant[]
  images   ProductImage[]

  @@index([category])
  @@index([featured])
  @@index([createdAt])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Identity of this variant within its product: "XS".."XXL" for sized goods,
  /// or SINGLE_UNIT_SIZE_KEY for a cap or tote sold as one unit.
  ///
  /// Never null. A nullable size cannot carry a unique constraint, because
  /// Postgres treats NULLs as distinct from one another, which would permit
  /// duplicate size-less variants. Keeping this non-null makes both the
  /// uniqueness rule and the display decision ("is this sized at all?") a plain
  /// comparison, with no fabricated "One Size" written to the database.
  sizeKey String

  /// Display order within the product. XS before S before XL, independent of
  /// collation, so it is data rather than a hardcoded ranking in application code.
  position Int @default(0)

  /// Units on hand. Product availability is always summed from these rows.
  quantity Int @default(0)

  /// Unique across variants; also the key the seed upserts on, which is what
  /// makes re-running the seed idempotent.
  sku String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, sizeKey])
  @@unique([productId, position])
  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Null while the generated flat is the only artwork. Once a shoot lands this
  /// is populated and the storefront prefers it over the generated silhouette.
  url String?

  /// Describes this image, not the product generally. Required even while the
  /// artwork is generated, because the flat is announced to assistive tech.
  alt String

  /// Backdrop for the generated artwork, and which crop the view uses.
  tone ProductTone @default(BONE)

  /// Zero-based display order.
  position Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, position])
  @@index([productId])
}